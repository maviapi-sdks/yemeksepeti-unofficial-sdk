                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": "object",
                            "example": {
                              "code": "frtm",
                              "id": 272240,
                              "name": "Helvacı Ali",
                              "rating": 3.9,
                              "review_count": 205,
                              "cuisines": [
                                "Tatlı"
                              ],
                              "primary_cuisine": "Tatlı",
                              "budget": 1,
                              "address": "Hasfırın Cd. 13/B",
                              "city": "Istanbul",
                              "latitude": 41.043,
                              "longitude": 29.006,
                              "distance_km": 3.862,
                              "minimum_order_amount": 0,
                              "delivery_fee": 0,
                              "delivery_time_minutes": 30,
                              "currency": "TRY",
                              "is_delivery_available": true,
                              "is_pickup_available": false,
                              "is_open": true,
