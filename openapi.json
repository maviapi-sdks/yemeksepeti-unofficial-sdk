            "$ref": "#/components/responses/RateLimited"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamFailed"
          }
        }
      }
    },
    "/restaurants": {
      "get": {
        "operationId": "restaurants",
        "summary": "Restaurant discovery",
        "description": "List and filter restaurants delivering to a location (by city or lat/lng). Filter by cuisine (id or name) and sort; paginated.",
        "x-credits": 1,
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City to deliver to (ignored if lat/lng are given).",
            "schema": {
              "type": "string",
              "enum": [
                "istanbul",
                "ankara",
                "izmir",
                "bursa",
                "antalya",
                "adana",
                "gaziantep",
                "konya"
              ],
              "default": "istanbul"
            },
            "example": "istanbul"
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude (overrides city).",
            "schema": {
              "type": "number"
            },
            "example": 41.0082
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "description": "Longitude (overrides city).",
            "schema": {
              "type": "number"
            },
            "example": 28.9784
          },
          {
            "name": "cuisine",
            "in": "query",
            "required": false,
            "description": "Filter by cuisine: a numeric cuisine id or a name (e.g. 'Burger', 'Pizza'). See available_cuisines in the response for valid values.",
            "schema": {
              "type": "string"
            },
            "example": "Burger"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order for the results.",
            "schema": {
              "type": "string",
              "enum": [
                "",
                "rating",
                "delivery_time",
                "distance",
                "minimum_order_amount"
              ]
            },
            "example": "rating"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size (max 60).",
            "schema": {
              "type": "integer",
              "default": 30
            },
            "example": 30
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Items to skip.",
            "schema": {
              "type": "integer",
              "default": 0
            },
            "example": 0
          },
          {
            "name": "refresh",
            "in": "query",
            "required": false,
            "description": "Bypass and repopulate the cache.",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "example": false
          }
        ],
        "responses": {
