  "components": {
    "securitySchemes": {
      "maviapiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your maviapi API key, sent as `Authorization: Bearer <key>`. Create one at https://maviapi.com/dashboard/keys."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Machine-readable code, e.g. `rate_limited`."
          },
          "message": {
            "type": "string",
            "description": "What went wrong, in a sentence."
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "A parameter is missing or cannot be used.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "bad_request",
              "message": "Missing required query parameter: q"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "No API key was sent, or the key is invalid or revoked (`missing_api_key`, `invalid_api_key`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "missing_api_key",
              "message": "Provide an API key via the Authorization: Bearer <key> header."
            }
          }
        }
      },
      "CreditLimitReached": {
        "description": "The plan's credits for this period are used up.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "credit_limit_reached",
              "message": "You've used all 5,000 credits in your Trial plan for this period. Upgrade your plan for a higher allotment."
            }
          }
        }
      },
      "AccountSuspended": {
        "description": "The account that owns the key is suspended.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "account_banned",
              "message": "Your account is suspended."
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests for this key. Wait the number of seconds in `Retry-After`.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "rate_limited",
              "message": "Rate limit exceeded for this API key."
            }
          }
        }
      },
      "UpstreamFailed": {
        "description": "The source site could not be read this time. Retrying later usually works.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "scrape_failed",
              "message": "The upstream source could not be fetched"
            }
          }
        }
      }
    }
  }
}
